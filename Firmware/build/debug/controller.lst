  51:controller/controller.c ****   // ---------- VE & ignition tables (realistic torque curve + RPM/load) ----------
  52:controller/controller.c ****   for (size_t i = 0; i < TABLE_PRIMARY_SIZE_X; i++)
  53:controller/controller.c ****   {
  54:controller/controller.c ****     float rpm_factor = (float)i / (TABLE_PRIMARY_SIZE_X - 1); // 0..1 across RPM
  55:controller/controller.c **** 
  56:controller/controller.c ****     // Approximate torque curve: peak around mid-RPM
  57:controller/controller.c ****     float ve_rpm_scale = 0.8f * sinf(rpm_factor * 3.14159f) + 0.2f; // 0.2..1.0
  58:controller/controller.c **** 
  59:controller/controller.c ****     for (size_t j = 0; j < TABLE_PRIMARY_SIZE_Y; j++)
  60:controller/controller.c ****     {
  61:controller/controller.c ****       float map_factor = (float)j / (TABLE_PRIMARY_SIZE_Y - 1); // 0..1 across MAP/load
  62:controller/controller.c **** 
  63:controller/controller.c ****       // VE table: scales with torque curve and load
  64:controller/controller.c ****       config.ve_table_1.data[i][j] = 20.0f + 70.0f * ve_rpm_scale * map_factor;
