  49:controller/controller.c **** void controller_load_test_configuration()
  50:controller/controller.c **** {
  51:controller/controller.c **** 
  52:controller/controller.c ****   // ---------- VE & ignition tables (realistic torque curve + RPM/load) ----------
  53:controller/controller.c ****   for (size_t i = 0; i < TABLE_PRIMARY_SIZE_X; i++)
  54:controller/controller.c ****   {
  55:controller/controller.c ****     float rpm_factor = (float)i / (TABLE_PRIMARY_SIZE_X - 1); // 0..1 across RPM
  56:controller/controller.c **** 
  57:controller/controller.c ****     // Approximate torque curve: peak around mid-RPM
  58:controller/controller.c ****     float ve_rpm_scale = 0.8f * sinf(rpm_factor * 3.14159f) + 0.2f; // 0.2..1.0
  59:controller/controller.c **** 
  60:controller/controller.c ****     for (size_t j = 0; j < TABLE_PRIMARY_SIZE_Y; j++)
  61:controller/controller.c ****     {
  62:controller/controller.c ****       float map_factor = (float)j / (TABLE_PRIMARY_SIZE_Y - 1); // 0..1 across MAP/load
  63:controller/controller.c **** 
  64:controller/controller.c ****       // VE table: scales with torque curve and load
  65:controller/controller.c ****       config.ve_table_1.data[i][j] = 20.0f + 70.0f * ve_rpm_scale * map_factor;
  66:controller/controller.c ****       config.ve_table_2.data[i][j] = 20.0f + 70.0f * ve_rpm_scale * map_factor;
  67:controller/controller.c **** 
  68:controller/controller.c ****       // Ignition table: base 10° at idle, +20° with RPM, -10° with load
  69:controller/controller.c ****       config.ign_table_1.data[i][j] = 10.0f + 20.0f * rpm_factor - 10.0f * map_factor;
  70:controller/controller.c ****       config.ign_table_2.data[i][j] = 10.0f + 20.0f * rpm_factor - 10.0f * map_factor;
  71:controller/controller.c ****     }
  72:controller/controller.c ****   }
  73:controller/controller.c **** 
  74:controller/controller.c ****   // x_bins: RPM axis
  75:controller/controller.c ****   for (size_t i = 0; i < TABLE_PRIMARY_SIZE_X; i++)
  76:controller/controller.c ****   {
  77:controller/controller.c ****     config.ve_table_1.x_bins[i] = i * FIRMWARE_LIMIT_MAX_RPM / TABLE_PRIMARY_SIZE_X;
  78:controller/controller.c ****     config.ve_table_2.x_bins[i] = i * FIRMWARE_LIMIT_MAX_RPM / TABLE_PRIMARY_SIZE_X;
  79:controller/controller.c ****     config.ign_table_1.x_bins[i] = i * FIRMWARE_LIMIT_MAX_RPM / TABLE_PRIMARY_SIZE_X;
  80:controller/controller.c ****     config.ign_table_2.x_bins[i] = i * FIRMWARE_LIMIT_MAX_RPM / TABLE_PRIMARY_SIZE_X;
  81:controller/controller.c ****   }
  82:controller/controller.c **** 
  83:controller/controller.c ****   // y_bins: MAP/load axis
  84:controller/controller.c ****   for (size_t i = 0; i < TABLE_PRIMARY_SIZE_Y; i++)
  85:controller/controller.c ****   {
  86:controller/controller.c ****     config.ve_table_1.y_bins[i] = i * FIRMWARE_LIMIT_MAX_MAP / TABLE_PRIMARY_SIZE_Y;
  87:controller/controller.c ****     config.ve_table_2.y_bins[i] = i * FIRMWARE_LIMIT_MAX_MAP / TABLE_PRIMARY_SIZE_Y;
ARM GAS  C:\Users\alireza\AppData\Local\Temp\ccTbDjnH.s 			page 3


  88:controller/controller.c ****     config.ign_table_1.y_bins[i] = i * FIRMWARE_LIMIT_MAX_MAP / TABLE_PRIMARY_SIZE_Y;
  89:controller/controller.c ****     config.ign_table_2.y_bins[i] = i * FIRMWARE_LIMIT_MAX_MAP / TABLE_PRIMARY_SIZE_Y;
  90:controller/controller.c ****   }
