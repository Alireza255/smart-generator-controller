   2:controller/algorithm/fuel/fuel_math.c **** /**
   3:controller/algorithm/fuel/fuel_math.c ****  * Ideal gas law is PV = nRT
   4:controller/algorithm/fuel/fuel_math.c ****  * n = m / M        while M is molar weight
   5:controller/algorithm/fuel/fuel_math.c ****  * Derived via:
   6:controller/algorithm/fuel/fuel_math.c ****  * (8.31 J K mol^-1)  <- ideal gas constant R
   7:controller/algorithm/fuel/fuel_math.c ****  *
   8:controller/algorithm/fuel/fuel_math.c ****  * (28.97g mol^-1)    <- molar mass of air
   9:controller/algorithm/fuel/fuel_math.c ****  * = 0.28705 J*K/g
  10:controller/algorithm/fuel/fuel_math.c ****  */
  11:controller/algorithm/fuel/fuel_math.c **** #define AIR_MOLAR_MASS 28.9647f          // g/mol
  12:controller/algorithm/fuel/fuel_math.c **** #define UNIVERSAL_GAS_CONST 8.314462618f // J/(K*mol)
