 276:controller/utils/comms.c ****         page_crc = swap_endian_uint32(page_crc);
 277:controller/utils/comms.c ****         send_response(TS_RESPONSE_OK, (uint8_t *)&page_crc, sizeof(page_crc), TS_CRC);
 278:controller/utils/comms.c ****         return;
 279:controller/utils/comms.c ****         break;
 280:controller/utils/comms.c **** 
