 304:controller/utils/comms.c ****         osEventFlagsSet(comms_os_flags, COMMS_SAVE_CONFIG_FLAG);
 305:controller/utils/comms.c ****         send_response(TS_RESPONSE_BURN_OK, NULL, 0, TS_CRC);
