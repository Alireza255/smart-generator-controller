   9:controller/utils/comms.c **** /*******************************************************************************
  10:controller/utils/comms.c ****  *                          TUNERSTUDIO PROTOCOL PACKET FORMAT
  11:controller/utils/comms.c ****  * 
  12:controller/utils/comms.c ****  * ┌───────────────────────────────
  13:controller/utils/comms.c ****  * │                            HOST → ECU REQUEST                            │
  14:controller/utils/comms.c ****  * ├──────────┬────────────────────
  15:controller/utils/comms.c ****  * │   SIZE   │              PAYLOAD (CMD + DATA)              │    CRC32     │
  16:controller/utils/comms.c ****  * └──────────┴────────────────────
  17:controller/utils/comms.c ****  * 
  18:controller/utils/comms.c ****  *    2 bytes                      N bytes                         4 bytes
  19:controller/utils/comms.c ****  * 
  20:controller/utils/comms.c ****  * 
  21:controller/utils/comms.c ****  * ┌───────────────────────────────
  22:controller/utils/comms.c ****  * │                            ECU → HOST RESPONSE                            │
  23:controller/utils/comms.c ****  * ├──────────┬──────────┬─────────
  24:controller/utils/comms.c ****  * │   SIZE   │   FLAG   │           PAYLOAD (DATA)             │    CRC32     │
  25:controller/utils/comms.c ****  * └──────────┴──────────┴─────────
  26:controller/utils/comms.c ****  * 
  27:controller/utils/comms.c ****  *    2 bytes    1 byte                 N bytes                    4 bytes
  28:controller/utils/comms.c ****  * 
  29:controller/utils/comms.c ****  * NOTES:
  30:controller/utils/comms.c ****  * - SIZE: Big-endian uint16 (payload length EXCLUDING CRC)
ARM GAS  C:\Users\alireza\AppData\Local\Temp\cciwdjcy.s 			page 2


  31:controller/utils/comms.c ****  * - FLAG: 0x00=OK, 0x7F=ERROR, 0x5A=DATA_PENDING
  32:controller/utils/comms.c ****  * - CRC32: Calculated over Size+Payload (EXCLUDING the CRC itself)
  33:controller/utils/comms.c ****  * - All multi-byte fields use BIG-ENDIAN byte order
  34:controller/utils/comms.c ****  * - Minimum packet size: 7 bytes (2+1+0+4 for empty response)
  35:controller/utils/comms.c ****  * For every packet sent to the Megasquirt, there will be a response packet, so the sender can vali
  36:controller/utils/comms.c **** reception. The sender MUST act on the response code and MUST check the CRC32.
  37:controller/utils/comms.c ****  ******************************************************************************/
  38:controller/utils/comms.c **** // ==================== Global Variables ====================
  39:controller/utils/comms.c **** osMessageQueueId_t usb_rx_queue;
  40:controller/utils/comms.c **** 
  41:controller/utils/comms.c **** usb_rx_packet_t rx_packet;
  42:controller/utils/comms.c **** /**
  43:controller/utils/comms.c ****  * See 'blockingFactor' in .ini
  44:controller/utils/comms.c ****  */
  45:controller/utils/comms.c **** uint8_t tx_buffer[TS_BLOCKING_FACTOR + 30];
  46:controller/utils/comms.c **** uint8_t rx_buffer[TS_BLOCKING_FACTOR + 30];
  47:controller/utils/comms.c **** 
  48:controller/utils/comms.c **** osEventFlagsId_t controller_command_flag = 0;
  49:controller/utils/comms.c **** osEventFlagsId_t comms_os_flags = 0;
  50:controller/utils/comms.c **** /* Function delcearations  */
  51:controller/utils/comms.c **** /**
  52:controller/utils/comms.c ****  * @note size can be zero to transmit an empty packet
  53:controller/utils/comms.c ****  */
  54:controller/utils/comms.c **** void send_response(uint8_t flag, uint8_t *data, size_t size, comms_response_format_t mode);
  55:controller/utils/comms.c **** void transmit_crc_packet(uint8_t flag, const uint8_t *buf, size_t size);
  56:controller/utils/comms.c **** bool process_plain_command(uint8_t *request, uint16_t size);
  57:controller/utils/comms.c **** void process_command(uint8_t *request, uint16_t size);
  58:controller/utils/comms.c **** void handle_page_read_command(uint16_t page, uint16_t offset, uint16_t count);
  59:controller/utils/comms.c **** void handle_page_write_command(uint16_t page, uint16_t offset, uint16_t count);
  60:controller/utils/comms.c **** 
  61:controller/utils/comms.c **** void run_controller_command(void *arg);
  62:controller/utils/comms.c **** void comms_activities_task(void *arg);
  63:controller/utils/comms.c **** /* Function definations */
  64:controller/utils/comms.c **** 
  65:controller/utils/comms.c **** void send_response(uint8_t flag, uint8_t *data, size_t size, comms_response_format_t mode)
  66:controller/utils/comms.c **** {
  67:controller/utils/comms.c **** 
  68:controller/utils/comms.c ****     if (mode == TS_CRC)
  69:controller/utils/comms.c ****     {
  70:controller/utils/comms.c ****         transmit_crc_packet(flag, data, size);
  71:controller/utils/comms.c ****     }
  72:controller/utils/comms.c ****     else
  73:controller/utils/comms.c ****     {
  74:controller/utils/comms.c ****         if (size > 0)
  75:controller/utils/comms.c ****         {
  76:controller/utils/comms.c **** 			memcpy(tx_buffer, data, size);
  77:controller/utils/comms.c ****             CDC_Transmit_FS(tx_buffer, size);
  78:controller/utils/comms.c ****         }
  79:controller/utils/comms.c ****     }
  80:controller/utils/comms.c **** 	HAL_GPIO_WritePin(LED_GPIO_Port, LED_Pin, GPIO_PIN_SET);
  81:controller/utils/comms.c **** }
  82:controller/utils/comms.c **** 
  83:controller/utils/comms.c **** void transmit_crc_packet(uint8_t flag, const uint8_t *buf, size_t size)
  84:controller/utils/comms.c **** {
  85:controller/utils/comms.c **** 
  86:controller/utils/comms.c **** 	/* We first calculate the prefix */
  87:controller/utils/comms.c ****     uint16_t packet_size = 0;
ARM GAS  C:\Users\alireza\AppData\Local\Temp\cciwdjcy.s 			page 3


  88:controller/utils/comms.c **** 	packet_size += 2; // prefix
  89:controller/utils/comms.c **** 	packet_size += 1; // flag
  90:controller/utils/comms.c **** 	packet_size += 4; // CRC
  91:controller/utils/comms.c **** 	packet_size += size; // payload
  92:controller/utils/comms.c **** 
  93:controller/utils/comms.c **** 	/* Converte the size to big endian */
  94:controller/utils/comms.c **** 	uint16_t prefix = 0;
  95:controller/utils/comms.c **** 	prefix = swap_endian_uint16(sizeof(flag) + size);
  96:controller/utils/comms.c **** 
  97:controller/utils/comms.c **** 	/* Now we calculate the CRC, over the flag and payload */
  98:controller/utils/comms.c **** 	uint32_t crc = 0;
  99:controller/utils/comms.c **** 	crc = crc32_inc(0, (void*)&flag, 1); // flag
 100:controller/utils/comms.c **** 	crc = crc32_inc(crc, buf, size); // payload
 101:controller/utils/comms.c **** 
 102:controller/utils/comms.c **** 	/* Converte the crc to big endian */
 103:controller/utils/comms.c **** 	uint32_t suffix = 0;
 104:controller/utils/comms.c **** 	suffix = swap_endian_uint32(crc);
 105:controller/utils/comms.c **** 
 106:controller/utils/comms.c **** 	/* Form the packet in the transmit buffer */
 107:controller/utils/comms.c **** 	size_t tx_buffer_index = 0;
 108:controller/utils/comms.c **** 	memcpy(tx_buffer, &prefix, sizeof(prefix)); // prefix to buffer
 109:controller/utils/comms.c **** 	tx_buffer_index += sizeof(prefix);
 110:controller/utils/comms.c **** 	memcpy(tx_buffer + tx_buffer_index, &flag, sizeof(flag)); // flag to buffer
 111:controller/utils/comms.c **** 	tx_buffer_index += sizeof(flag);
 112:controller/utils/comms.c **** 	memcpy(tx_buffer + tx_buffer_index, buf, size); // payload to buffer
 113:controller/utils/comms.c **** 	tx_buffer_index += size;
 114:controller/utils/comms.c **** 	memcpy(tx_buffer + tx_buffer_index, &suffix, sizeof(suffix)); // suffix to buffer
 115:controller/utils/comms.c **** 	tx_buffer_index += sizeof(suffix);
 116:controller/utils/comms.c **** 
 117:controller/utils/comms.c **** 	/* Finally transmit over USB */
 118:controller/utils/comms.c **** 
 119:controller/utils/comms.c **** 	CDC_Transmit_FS(tx_buffer, packet_size);
 120:controller/utils/comms.c **** }
