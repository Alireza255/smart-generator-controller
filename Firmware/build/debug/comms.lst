  80:controller/utils/utils.h **** #define MAP(x, in_min, in_max, out_min, out_max) \
  81:controller/utils/utils.h ****     (((x) - (in_min)) * ((out_max) - (out_min)) / ((in_max) - (in_min)) + (out_min))
  82:controller/utils/utils.h **** 
  83:controller/utils/utils.h **** /**
  84:controller/utils/utils.h ****  * @brief Maps a uint16_t value from one range to another.
