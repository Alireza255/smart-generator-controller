  94:controller/utils/utils.h **** {
  95:controller/utils/utils.h ****     if (in_max == in_min)
  96:controller/utils/utils.h ****     {
  97:controller/utils/utils.h ****         return 0; // Avoid division by zero
  98:controller/utils/utils.h ****     }
  99:controller/utils/utils.h ****     return (uint16_t)((x - in_min) * (out_max - out_min) / (in_max - in_min) + out_min);
