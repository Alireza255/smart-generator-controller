 203:controller/utils/comms.c **** void process_command(uint8_t *request, uint16_t size)
 204:controller/utils/comms.c **** {
 205:controller/utils/comms.c ****     if (process_plain_command(request, size))
 206:controller/utils/comms.c ****     {
 207:controller/utils/comms.c ****         return;
 208:controller/utils/comms.c ****     }
 209:controller/utils/comms.c ****     uint16_t packet_size = 0;
 210:controller/utils/comms.c ****     uint32_t packet_crc = 0;
 211:controller/utils/comms.c ****     uint32_t calculated_packet_crc = 0;
 212:controller/utils/comms.c ****     bool is_packet_valid = false;
 213:controller/utils/comms.c ****     if (size > 5)
 214:controller/utils/comms.c ****     {
 215:controller/utils/comms.c ****         packet_size = swap_endian_uint16(*(uint16_t *)request);
 216:controller/utils/comms.c ****         packet_crc = swap_endian_uint32(*(uint32_t *)request[size - 1 - TS_PACKET_CRC_SIZE]);
 217:controller/utils/comms.c ****         calculated_packet_crc = crc32_inc(0, (void *)(request + TS_PACKET_PREFIX_SIZE), size - TS_P
 218:controller/utils/comms.c ****     }
