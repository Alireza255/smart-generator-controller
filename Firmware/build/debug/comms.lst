 166:controller/utils/comms.c **** // ==================== Command Processing ====================
 167:controller/utils/comms.c **** bool process_plain_command(uint8_t *request, uint16_t size)
 168:controller/utils/comms.c **** {
 169:controller/utils/comms.c ****     uint8_t first_byte = request[0];
 170:controller/utils/comms.c ****     switch (first_byte)
 171:controller/utils/comms.c ****     {
 172:controller/utils/comms.c ****     case TS_COMMAND_F:
 173:controller/utils/comms.c ****     #ifndef TS_USE_OLD_PROTOCOL
 174:controller/utils/comms.c ****         send_response(0, (uint8_t*)TS_PROTOCOL, sizeof(TS_PROTOCOL) - 1, TS_PLAIN);
 175:controller/utils/comms.c ****         return true;
 176:controller/utils/comms.c ****     #endif
 177:controller/utils/comms.c ****         break;
 178:controller/utils/comms.c ****     case TS_HELLO_COMMAND:
 179:controller/utils/comms.c ****         send_response(0, (uint8_t*)TS_SIGNATURE, sizeof(TS_SIGNATURE) - 1, TS_PLAIN);
 180:controller/utils/comms.c ****         return true;
 181:controller/utils/comms.c ****         break;
 182:controller/utils/comms.c ****     case TS_QUERY_COMMAND:
 183:controller/utils/comms.c ****         send_response(0, (uint8_t*)TS_SIGNATURE, sizeof(TS_SIGNATURE) - 1, TS_PLAIN);
 184:controller/utils/comms.c ****         return true;
 185:controller/utils/comms.c ****         break;
 186:controller/utils/comms.c ****     case TS_TEST_COMMS_COMMAND:
 187:controller/utils/comms.c ****         send_response(0, (uint8_t *)0xFF, 1, TS_PLAIN);
 188:controller/utils/comms.c ****         return true;
 189:controller/utils/comms.c ****         break;
 190:controller/utils/comms.c ****     case TS_CAN_ID_COMMAND:
 191:controller/utils/comms.c ****         send_response(0, (uint8_t*)TS_CAN_ID, sizeof(TS_CAN_ID) - 1, TS_PLAIN);
 192:controller/utils/comms.c ****         return true;
 193:controller/utils/comms.c ****         break;
 194:controller/utils/comms.c **** 
 195:controller/utils/comms.c ****     default:
 196:controller/utils/comms.c ****         break;
 197:controller/utils/comms.c ****     }
 198:controller/utils/comms.c ****         // This wasn't a valid command
 199:controller/utils/comms.c ****         return false;
 200:controller/utils/comms.c ****     
 201:controller/utils/comms.c **** }
