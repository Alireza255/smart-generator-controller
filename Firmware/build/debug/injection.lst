 219:controller/utils/utils.h **** /**
 220:controller/utils/utils.h ****  * @brief Wraps an angle in degrees to the range [0, 720).
 221:controller/utils/utils.h ****  *
 222:controller/utils/utils.h ****  * This function ensures that the input angle is normalized to the range [0, 720).
 223:controller/utils/utils.h ****  * If the input angle is negative, it adds 720 repeatedly until the angle is non-negative.
 224:controller/utils/utils.h ****  * If the input angle is greater than or equal to 720, it subtracts 720 repeatedly
 225:controller/utils/utils.h ****  * until the angle is less than 720.
 226:controller/utils/utils.h ****  *
 227:controller/utils/utils.h ****  * @param angle The input angle in degrees to be wrapped.
 228:controller/utils/utils.h ****  * @return The wrapped angle in the range [0, 720).
 229:controller/utils/utils.h ****  */
 230:controller/utils/utils.h **** static inline angle_t wrap_angle_720(angle_t angle)
ARM GAS  C:\Users\alireza\AppData\Local\Temp\ccA4cRbR.s 			page 43


 231:controller/utils/utils.h **** {
 232:controller/utils/utils.h ****     while (angle < 0.0f)
 233:controller/utils/utils.h ****     {
 234:controller/utils/utils.h ****         angle += 720.0f;
 235:controller/utils/utils.h ****     }
 236:controller/utils/utils.h ****     while (angle >= 720.0f)
 237:controller/utils/utils.h ****     {
 238:controller/utils/utils.h ****         angle -= 720.0f;
 239:controller/utils/utils.h ****     }
 240:controller/utils/utils.h ****     return angle;
 241:controller/utils/utils.h **** }
 242:controller/utils/utils.h **** 
 243:controller/utils/utils.h **** /**
 244:controller/utils/utils.h ****  * @brief Compute the forward angular distance from `from` to `to` in a 720° cycle.
 245:controller/utils/utils.h ****  *
 246:controller/utils/utils.h ****  * Always returns a value in the range [0, 720).
 247:controller/utils/utils.h ****  * This represents the forward (positive rotation) distance,
 248:controller/utils/utils.h ****  * not the shortest path between the angles.
 249:controller/utils/utils.h ****  *
 250:controller/utils/utils.h ****  * Useful whenever angles are cyclic with a period of 720°,
 251:controller/utils/utils.h ****  *
 252:controller/utils/utils.h ****  * Examples:
 253:controller/utils/utils.h ****  *   angular_forward_distance_720(700, 20)   -> 40
 254:controller/utils/utils.h ****  *   angular_forward_distance_720(100, 20)   -> 640
 255:controller/utils/utils.h ****  *   angular_forward_distance_720(180, 270)  -> 90
 256:controller/utils/utils.h ****  *
 257:controller/utils/utils.h ****  * @param from Start angle, in degrees [0..720)
 258:controller/utils/utils.h ****  * @param to   Target angle, in degrees [0..720)
 259:controller/utils/utils.h ****  * @return Forward angular distance in degrees [0..720)
 260:controller/utils/utils.h ****  */
 261:controller/utils/utils.h **** static inline angle_t angular_forward_distance_720(angle_t from, angle_t to)
 262:controller/utils/utils.h **** {
 263:controller/utils/utils.h ****     angle_t dist = to - from;
 264:controller/utils/utils.h ****     if (dist < 0.0f) {
 265:controller/utils/utils.h ****         dist += 720.0f;
 266:controller/utils/utils.h ****     }
 267:controller/utils/utils.h ****     return dist;
 268:controller/utils/utils.h **** }
 269:controller/utils/utils.h **** 
