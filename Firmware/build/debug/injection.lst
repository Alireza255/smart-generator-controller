 138:controller/engine_cycle/injection.c **** void injection_watchdog_check()
 139:controller/engine_cycle/injection.c **** {
 140:controller/engine_cycle/injection.c ****     for (size_t i = 0; i < number_of_events; i++)
 141:controller/engine_cycle/injection.c ****     {
 142:controller/engine_cycle/injection.c ****         injection_event_t *event = &injection_events[i];
 143:controller/engine_cycle/injection.c ****         if (event->status != INJECTION_EVENT_INJECTING) continue;
 144:controller/engine_cycle/injection.c ****         time_us_t current_time = get_time_us();
 145:controller/engine_cycle/injection.c ****         if ((int32_t)(current_time - (event->injection_stop_time)) > 0)
 146:controller/engine_cycle/injection.c ****         {
 147:controller/engine_cycle/injection.c ****             injector_stop_injection((void *)event);
 148:controller/engine_cycle/injection.c ****             change_bit(&runtime.status, STATUS_INJECTOR_ERROR, true);
 149:controller/engine_cycle/injection.c ****             log_error("injection watchdog fired.");
 150:controller/engine_cycle/injection.c ****         }
 151:controller/engine_cycle/injection.c ****     } 
 152:controller/engine_cycle/injection.c **** }
