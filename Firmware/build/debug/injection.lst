 143:controller/engine_cycle/injection.c **** void injection_watchdog_check()
 144:controller/engine_cycle/injection.c **** {
 145:controller/engine_cycle/injection.c ****     for (size_t i = 0; i < number_of_events; i++)
 146:controller/engine_cycle/injection.c ****     {
 147:controller/engine_cycle/injection.c ****         injection_event_t *event = &injection_events[i];
 148:controller/engine_cycle/injection.c ****         if (event->status != INJECTION_EVENT_INJECTING) continue;
 149:controller/engine_cycle/injection.c ****         time_us_t current_time = get_time_us();
 150:controller/engine_cycle/injection.c ****         if ((int32_t)(current_time - (event->injection_stop_time)) > 0)
 151:controller/engine_cycle/injection.c ****         {
 152:controller/engine_cycle/injection.c ****             injector_stop_injection((void *)event);
 153:controller/engine_cycle/injection.c ****             change_bit(&runtime.status, STATUS_INJECTOR_ERROR, true);
 154:controller/engine_cycle/injection.c ****             log_error("injection watchdog fired.");
 155:controller/engine_cycle/injection.c ****         }
 156:controller/engine_cycle/injection.c ****     } 
 157:controller/engine_cycle/injection.c **** }
