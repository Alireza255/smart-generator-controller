 153:controller/actuators/electronic_throttle.c **** void electronic_throttle_auto_tune(electronic_throttle_t *etb)
 154:controller/actuators/electronic_throttle.c **** {
 155:controller/actuators/electronic_throttle.c ****     if (etb == NULL)
 156:controller/actuators/electronic_throttle.c ****     {
 157:controller/actuators/electronic_throttle.c ****         log_error("ETB Auto-Tune failed. ETB is null!");
 158:controller/actuators/electronic_throttle.c ****         return;
 159:controller/actuators/electronic_throttle.c ****     }
 160:controller/actuators/electronic_throttle.c ****     osDelay(100);
ARM GAS  C:\Users\alireza\AppData\Local\Temp\ccYla0Jh.s 			page 27


 161:controller/actuators/electronic_throttle.c ****     if (vbat_get() < ELECTRONIC_THROTTLE_AUTO_CALIB_MIN_VBAT)
 162:controller/actuators/electronic_throttle.c ****     {
 163:controller/actuators/electronic_throttle.c ****         log_error("ETB Auto-Tune failed. Vbat too low!");
 164:controller/actuators/electronic_throttle.c ****         return;
 165:controller/actuators/electronic_throttle.c ****     }
 166:controller/actuators/electronic_throttle.c ****     if (runtime.spinning_state != SS_STOPPED)
 167:controller/actuators/electronic_throttle.c ****     {
 168:controller/actuators/electronic_throttle.c ****         return;
 169:controller/actuators/electronic_throttle.c ****     }
 170:controller/actuators/electronic_throttle.c ****     
 171:controller/actuators/electronic_throttle.c ****     etb->control_loop_give_up_control = true;
 172:controller/actuators/electronic_throttle.c **** 
 173:controller/actuators/electronic_throttle.c ****     float vbat_compensation = 1;
 174:controller/actuators/electronic_throttle.c ****     voltage_t nominal_vbat = (voltage_t)12.6;
 175:controller/actuators/electronic_throttle.c ****     vbat_compensation = nominal_vbat / vbat_get();
 176:controller/actuators/electronic_throttle.c ****     /* First, we will try to find the end of travel for open and closed positions*/
 177:controller/actuators/electronic_throttle.c **** 
 178:controller/actuators/electronic_throttle.c ****     uint8_t opening_duty_cycle_limit = (float)160 * vbat_compensation; // 0 to 255
 179:controller/actuators/electronic_throttle.c ****     uint8_t closing_duty_cycle_limit = (float)180 * vbat_compensation; // 0 to 255
 180:controller/actuators/electronic_throttle.c ****     uint8_t duty_cycle_stride = 10;
 181:controller/actuators/electronic_throttle.c ****     uint16_t settling_time_delay = 150; // time it takes for the etb to move and settle
 182:controller/actuators/electronic_throttle.c ****     const uint8_t settled_state_adc_value_hystersis = 2;
 183:controller/actuators/electronic_throttle.c **** 
 184:controller/actuators/electronic_throttle.c ****     volatile uint16_t closed_adc_value = 0;
 185:controller/actuators/electronic_throttle.c ****     volatile uint16_t opened_adc_value = 0;
 186:controller/actuators/electronic_throttle.c ****     volatile uint16_t resting_adc_value = 0;
 187:controller/actuators/electronic_throttle.c ****     volatile percent_t resting_tps_value = 0;
 188:controller/actuators/electronic_throttle.c **** 
