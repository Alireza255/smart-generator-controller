 127:controller/actuators/electronic_throttle.c **** void electronic_throttle_auto_tune(electronic_throttle_t *etb)
 128:controller/actuators/electronic_throttle.c **** {
 129:controller/actuators/electronic_throttle.c ****     if (etb == NULL)
 130:controller/actuators/electronic_throttle.c ****     {
 131:controller/actuators/electronic_throttle.c ****         log_error("ETB Auto-Tune failed. ETB is null!");
 132:controller/actuators/electronic_throttle.c ****         return;
 133:controller/actuators/electronic_throttle.c ****     }
 134:controller/actuators/electronic_throttle.c ****     osDelay(100);
 135:controller/actuators/electronic_throttle.c ****     if (vbat_get() < ELECTRONIC_THROTTLE_AUTO_CALIB_MIN_VBAT)
 136:controller/actuators/electronic_throttle.c ****     {
 137:controller/actuators/electronic_throttle.c ****         log_error("ETB Auto-Tune failed. Vbat too low!");
 138:controller/actuators/electronic_throttle.c ****         return;
 139:controller/actuators/electronic_throttle.c ****     }
 140:controller/actuators/electronic_throttle.c ****     if (runtime.spinning_state != SS_STOPPED)
 141:controller/actuators/electronic_throttle.c ****     {
 142:controller/actuators/electronic_throttle.c ****         return;
 143:controller/actuators/electronic_throttle.c ****     }
 144:controller/actuators/electronic_throttle.c ****     
 145:controller/actuators/electronic_throttle.c ****     etb->control_loop_give_up_control = true;
 146:controller/actuators/electronic_throttle.c **** 
 147:controller/actuators/electronic_throttle.c ****     float vbat_compensation = 1;
 148:controller/actuators/electronic_throttle.c ****     voltage_t nominal_vbat = (voltage_t)12.6;
 149:controller/actuators/electronic_throttle.c ****     vbat_compensation = nominal_vbat / vbat_get();
 150:controller/actuators/electronic_throttle.c ****     /* First, we will try to find the end of travel for open and closed positions*/
 151:controller/actuators/electronic_throttle.c **** 
 152:controller/actuators/electronic_throttle.c ****     uint8_t opening_duty_cycle_limit = (float)160 * vbat_compensation; // 0 to 255
