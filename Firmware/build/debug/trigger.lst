  55:controller/utils/utils.h ****     }
  56:controller/utils/utils.h ****     else
  57:controller/utils/utils.h ****     {
  58:controller/utils/utils.h ****         *var &= (uint8_t)~(1u << bit);    // clear bit
  59:controller/utils/utils.h ****     }
