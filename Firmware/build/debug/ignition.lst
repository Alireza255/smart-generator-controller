 112:controller/utils/utils.h **** /**
 113:controller/utils/utils.h ****  * @brief Function to calculate the microseconds it takes for the engine to turn one degree.
 114:controller/utils/utils.h ****  * @note Returns 0 if rpm is 0.
 115:controller/utils/utils.h ****  */
 116:controller/utils/utils.h **** static inline time_us_t microseconds_per_degree(rpm_t rpm)
 117:controller/utils/utils.h **** {
 118:controller/utils/utils.h ****     if (rpm == 0)
 119:controller/utils/utils.h ****     {
 120:controller/utils/utils.h ****         return 0;
 121:controller/utils/utils.h ****     }
 122:controller/utils/utils.h ****     return (time_us_t)60.0f * 1e6f / (rpm * 360.0f);
 123:controller/utils/utils.h **** }
 124:controller/utils/utils.h **** 
 125:controller/utils/utils.h **** /**
 126:controller/utils/utils.h ****  * @brief Convert a rotation angle in degrees to time in microseconds at a given RPM.
 127:controller/utils/utils.h ****  *
 128:controller/utils/utils.h ****  * @param degrees Rotation angle in degrees (> 0)
 129:controller/utils/utils.h ****  * @param rpm     Rotational speed in RPM (> 0)
 130:controller/utils/utils.h ****  * @return Time in microseconds to rotate the given angle, or 0 if input is invalid
 131:controller/utils/utils.h ****  */
 132:controller/utils/utils.h **** static inline time_us_t degree_to_microseconds(angle_t degrees, rpm_t rpm)
 133:controller/utils/utils.h **** {
 134:controller/utils/utils.h ****     if (rpm <= 0 || degrees <= 0)
 135:controller/utils/utils.h ****     {
 136:controller/utils/utils.h ****         return 0;
 137:controller/utils/utils.h ****     }
 138:controller/utils/utils.h ****     return (time_us_t) (60.0f * 1e6f / (rpm * 360.0f) * degrees); 
 139:controller/utils/utils.h **** }
 140:controller/utils/utils.h **** 
 141:controller/utils/utils.h **** /**
