 216:controller/utils/utils.h **** /**
 217:controller/utils/utils.h ****  * @brief Wraps an angle in degrees to the range [0, 720).
 218:controller/utils/utils.h ****  *
 219:controller/utils/utils.h ****  * This function ensures that the input angle is normalized to the range [0, 720).
 220:controller/utils/utils.h ****  * If the input angle is negative, it adds 720 repeatedly until the angle is non-negative.
 221:controller/utils/utils.h ****  * If the input angle is greater than or equal to 720, it subtracts 720 repeatedly
 222:controller/utils/utils.h ****  * until the angle is less than 720.
 223:controller/utils/utils.h ****  *
 224:controller/utils/utils.h ****  * @param angle The input angle in degrees to be wrapped.
 225:controller/utils/utils.h ****  * @return The wrapped angle in the range [0, 720).
 226:controller/utils/utils.h ****  */
 227:controller/utils/utils.h **** static inline angle_t wrap_angle_720(angle_t angle)
 228:controller/utils/utils.h **** {
 229:controller/utils/utils.h ****     while (angle < 0.0f)
 230:controller/utils/utils.h ****     {
 231:controller/utils/utils.h ****         angle += 720.0f;
 232:controller/utils/utils.h ****     }
 233:controller/utils/utils.h ****     while (angle >= 720.0f)
 234:controller/utils/utils.h ****     {
 235:controller/utils/utils.h ****         angle -= 720.0f;
 236:controller/utils/utils.h ****     }
 237:controller/utils/utils.h ****     return angle;
 238:controller/utils/utils.h **** }
 239:controller/utils/utils.h **** 
 240:controller/utils/utils.h **** /**
 241:controller/utils/utils.h ****  * @brief Compute the forward angular distance from `from` to `to` in a 720° cycle.
 242:controller/utils/utils.h ****  *
 243:controller/utils/utils.h ****  * Always returns a value in the range [0, 720).
 244:controller/utils/utils.h ****  * This represents the forward (positive rotation) distance,
 245:controller/utils/utils.h ****  * not the shortest path between the angles.
 246:controller/utils/utils.h ****  *
 247:controller/utils/utils.h ****  * Useful whenever angles are cyclic with a period of 720°,
 248:controller/utils/utils.h ****  *
 249:controller/utils/utils.h ****  * Examples:
 250:controller/utils/utils.h ****  *   angular_forward_distance_720(700, 20)   -> 40
 251:controller/utils/utils.h ****  *   angular_forward_distance_720(100, 20)   -> 640
 252:controller/utils/utils.h ****  *   angular_forward_distance_720(180, 270)  -> 90
 253:controller/utils/utils.h ****  *
 254:controller/utils/utils.h ****  * @param from Start angle, in degrees [0..720)
 255:controller/utils/utils.h ****  * @param to   Target angle, in degrees [0..720)
 256:controller/utils/utils.h ****  * @return Forward angular distance in degrees [0..720)
 257:controller/utils/utils.h ****  */
 258:controller/utils/utils.h **** static inline angle_t angular_forward_distance_720(angle_t from, angle_t to)
ARM GAS  C:\Users\alireza\AppData\Local\Temp\cc4TySJq.s 			page 55


