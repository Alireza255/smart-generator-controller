 172:controller/utils/utils.h ****     {
 173:controller/utils/utils.h ****         return 0.0f;
 174:controller/utils/utils.h ****     }
 175:controller/utils/utils.h ****     return (angle_t)(rpm * 360.0f) / (60.0f * 1e3f);
 176:controller/utils/utils.h **** }
