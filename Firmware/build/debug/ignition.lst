 177:controller/utils/utils.h **** /*----------------------------------------------------------------------------*\
 178:controller/utils/utils.h ****  *  NAME:
 179:controller/utils/utils.h ****  *     Crc32_ComputeBuf() - computes the CRC-32 value of a memory buffer
 180:controller/utils/utils.h ****  *  DESCRIPTION:
 181:controller/utils/utils.h ****  *     Computes or accumulates the CRC-32 value for a memory buffer.
 182:controller/utils/utils.h ****  *     The 'inCrc32' gives a previously accumulated CRC-32 value to allow
 183:controller/utils/utils.h ****  *     a CRC to be generated for multiple sequential buffer-fuls of data.
 184:controller/utils/utils.h ****  *     The 'inCrc32' for the first buffer must be zero.
 185:controller/utils/utils.h ****  *  ARGUMENTS:
 186:controller/utils/utils.h ****  *     inCrc32 - accumulated CRC-32 value, must be 0 on first call
 187:controller/utils/utils.h ****  *     buf     - buffer to compute CRC-32 value for
 188:controller/utils/utils.h ****  *     bufLen  - number of bytes in buffer
 189:controller/utils/utils.h ****  *  RETURNS:
 190:controller/utils/utils.h ****  *     crc32 - computed CRC-32 value
 191:controller/utils/utils.h ****  *  ERRORS:
 192:controller/utils/utils.h ****  *     (no errors are possible)
 193:controller/utils/utils.h **** \*----------------------------------------------------------------------------*/
