 145:controller/utils/utils.h **** static inline angle_t degrees_per_microsecond(rpm_t rpm)
 146:controller/utils/utils.h **** {
 147:controller/utils/utils.h ****     if (rpm == 0)
 148:controller/utils/utils.h ****     {
 149:controller/utils/utils.h ****         return 0.0f;
 150:controller/utils/utils.h ****     }
 151:controller/utils/utils.h ****     return (angle_t)(rpm * 360.0f) / (60.0f * 1e6f);
 152:controller/utils/utils.h **** }
 153:controller/utils/utils.h **** 
 154:controller/utils/utils.h **** static inline angle_t degrees_per_millisecond(rpm_t rpm)
 155:controller/utils/utils.h **** {
 156:controller/utils/utils.h ****     if (rpm == 0)
 157:controller/utils/utils.h ****     {
 158:controller/utils/utils.h ****         return 0.0f;
 159:controller/utils/utils.h ****     }
 160:controller/utils/utils.h ****     return (angle_t)(rpm * 360.0f) / (60.0f * 1e3f);
 161:controller/utils/utils.h **** }
