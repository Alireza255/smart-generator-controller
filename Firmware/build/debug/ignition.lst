 234:controller/utils/utils.h **** /**
 235:controller/utils/utils.h ****  * @brief Wraps an angle in degrees to the range [0, 720).
 236:controller/utils/utils.h ****  *
 237:controller/utils/utils.h ****  * This function ensures that the input angle is normalized to the range [0, 720).
 238:controller/utils/utils.h ****  * If the input angle is negative, it adds 720 repeatedly until the angle is non-negative.
 239:controller/utils/utils.h ****  * If the input angle is greater than or equal to 720, it subtracts 720 repeatedly
 240:controller/utils/utils.h ****  * until the angle is less than 720.
 241:controller/utils/utils.h ****  *
 242:controller/utils/utils.h ****  * @param angle The input angle in degrees to be wrapped.
 243:controller/utils/utils.h ****  * @return The wrapped angle in the range [0, 720).
 244:controller/utils/utils.h ****  */
 245:controller/utils/utils.h **** static inline angle_t wrap_angle_720(angle_t angle)
 246:controller/utils/utils.h **** {
 247:controller/utils/utils.h ****     while (angle < 0.0f)
 248:controller/utils/utils.h ****     {
 249:controller/utils/utils.h ****         angle += 720.0f;
 250:controller/utils/utils.h ****     }
 251:controller/utils/utils.h ****     while (angle >= 720.0f)
 252:controller/utils/utils.h ****     {
 253:controller/utils/utils.h ****         angle -= 720.0f;
 254:controller/utils/utils.h ****     }
 255:controller/utils/utils.h ****     return angle;
 256:controller/utils/utils.h **** }
 257:controller/utils/utils.h **** 
 258:controller/utils/utils.h **** /**
 259:controller/utils/utils.h ****  * @brief Compute the forward angular distance from `from` to `to` in a 720° cycle.
 260:controller/utils/utils.h ****  *
 261:controller/utils/utils.h ****  * Always returns a value in the range [0, 720).
 262:controller/utils/utils.h ****  * This represents the forward (positive rotation) distance,
 263:controller/utils/utils.h ****  * not the shortest path between the angles.
 264:controller/utils/utils.h ****  *
 265:controller/utils/utils.h ****  * Useful whenever angles are cyclic with a period of 720°,
ARM GAS  C:\Users\alireza\AppData\Local\Temp\ccCQeHKy.s 			page 54


 266:controller/utils/utils.h ****  *
 267:controller/utils/utils.h ****  * Examples:
 268:controller/utils/utils.h ****  *   angular_forward_distance_720(700, 20)   -> 40
 269:controller/utils/utils.h ****  *   angular_forward_distance_720(100, 20)   -> 640
 270:controller/utils/utils.h ****  *   angular_forward_distance_720(180, 270)  -> 90
 271:controller/utils/utils.h ****  *
 272:controller/utils/utils.h ****  * @param from Start angle, in degrees [0..720)
 273:controller/utils/utils.h ****  * @param to   Target angle, in degrees [0..720)
 274:controller/utils/utils.h ****  * @return Forward angular distance in degrees [0..720)
 275:controller/utils/utils.h ****  */
 276:controller/utils/utils.h **** static inline angle_t angular_forward_distance_720(angle_t from, angle_t to)
 277:controller/utils/utils.h **** {
 278:controller/utils/utils.h ****     angle_t dist = to - from;
 279:controller/utils/utils.h ****     if (dist < 0.0f) {
 280:controller/utils/utils.h ****         dist += 720.0f;
 281:controller/utils/utils.h ****     }
 282:controller/utils/utils.h ****     return dist;
 283:controller/utils/utils.h **** }
 284:controller/utils/utils.h **** 
