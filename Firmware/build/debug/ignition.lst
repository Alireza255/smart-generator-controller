 163:controller/utils/utils.h ****     {
 164:controller/utils/utils.h ****         return 0.0f;
 165:controller/utils/utils.h ****     }
 166:controller/utils/utils.h ****     return (angle_t)(rpm * 360.0f) / (60.0f * 1e6f);
 167:controller/utils/utils.h **** }
 168:controller/utils/utils.h **** 
 169:controller/utils/utils.h **** static inline angle_t degrees_per_millisecond(rpm_t rpm)
 170:controller/utils/utils.h **** {
