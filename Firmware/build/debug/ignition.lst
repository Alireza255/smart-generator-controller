 112:controller/utils/utils.h **** inline uint16_t swap_endian_uint16(uint16_t x)
 113:controller/utils/utils.h **** {
 114:controller/utils/utils.h ****     return ((x << 8) | (x >> 8));
 115:controller/utils/utils.h **** }
