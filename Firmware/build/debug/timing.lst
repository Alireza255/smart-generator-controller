   1:controller/utils/timing.c **** /* timing.c
   2:controller/utils/timing.c ****  *
   3:controller/utils/timing.c ****  * Robust single-file scheduler implementation.
   4:controller/utils/timing.c ****  * - Critical sections protect shared state
   5:controller/utils/timing.c ****  * - Generation-based handles avoid reuse races
   6:controller/utils/timing.c ****  * - Cancel API provided
   7:controller/utils/timing.c ****  * - Callbacks are executed in ISR context (by request)
   8:controller/utils/timing.c ****  *
   9:controller/utils/timing.c ****  * Requirements/assumptions:
  10:controller/utils/timing.c ****  * - CMSIS macros __get_PRIMASK(), __disable_irq(), __enable_irq() are available
  11:controller/utils/timing.c ****  *   (standard in STM32 HAL projects).
  12:controller/utils/timing.c ****  * - types.h defines time_us_t / time_ms_t.
  13:controller/utils/timing.c ****  * - tim.h provides TIM_HandleTypeDef and HAL symbols.
  14:controller/utils/timing.c ****  * - Uses 32-bit microsecond ticks (timer CNT -> 1us per tick). Tweak PSC calculation
  15:controller/utils/timing.c ****  *   in controller_timing_start if your timer clock is different.
  16:controller/utils/timing.c ****  */
  17:controller/utils/timing.c **** 
  18:controller/utils/timing.c **** #include "timing.h"
  19:controller/utils/timing.c **** #include <stdint.h>
