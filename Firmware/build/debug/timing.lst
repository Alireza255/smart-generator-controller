  42:controller/utils/timing.c **** /* ---------- Critical section helpers (PRIMASK-based) ---------- */
  43:controller/utils/timing.c **** static inline uint32_t enter_critical(void)
  44:controller/utils/timing.c **** {
  45:controller/utils/timing.c ****     uint32_t prim = __get_PRIMASK();
  46:controller/utils/timing.c ****     __disable_irq();
  47:controller/utils/timing.c ****     return prim;
  48:controller/utils/timing.c **** }
  49:controller/utils/timing.c **** 
  50:controller/utils/timing.c **** static inline void exit_critical(uint32_t prim)
  51:controller/utils/timing.c **** {
  52:controller/utils/timing.c ****     if ((prim & 1U) == 0U) {
  53:controller/utils/timing.c ****         __enable_irq();
  54:controller/utils/timing.c ****     }
  55:controller/utils/timing.c **** }
  56:controller/utils/timing.c **** 
  57:controller/utils/timing.c **** /* ---------- Handle helpers ---------- */
  58:controller/utils/timing.c **** static inline scheduler_handle_t make_handle(uint16_t generation, uint16_t index)
  59:controller/utils/timing.c **** {
  60:controller/utils/timing.c ****     if (generation == 0U) generation = 1U; /* avoid zero-generation (reserved) */
  61:controller/utils/timing.c ****     return (((uint32_t)generation << 16) | (uint32_t)index);
  62:controller/utils/timing.c **** }
  63:controller/utils/timing.c **** 
  64:controller/utils/timing.c **** static inline void decode_handle(scheduler_handle_t h, uint16_t *out_idx, uint16_t *out_gen)
  65:controller/utils/timing.c **** {
  66:controller/utils/timing.c ****     if (h == SCHEDULER_HANDLE_INVALID) {
  67:controller/utils/timing.c ****         *out_idx = UINT16_MAX;
  68:controller/utils/timing.c ****         *out_gen = 0;
  69:controller/utils/timing.c ****         return;
  70:controller/utils/timing.c ****     }
  71:controller/utils/timing.c ****     *out_idx = (uint16_t)(h & 0xFFFFU);
  72:controller/utils/timing.c ****     *out_gen = (uint16_t)((h >> 16) & 0xFFFFU);
  73:controller/utils/timing.c **** }
