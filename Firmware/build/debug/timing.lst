  29:controller/utils/timing.c ****     volatile uint32_t timestamp_us;    /* when the event should fire */
  30:controller/utils/timing.c ****     void (*callback_noarg)(void);
  31:controller/utils/timing.c ****     void (*callback_arg)(void *);
